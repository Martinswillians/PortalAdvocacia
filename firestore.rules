rules_version = '2';

// =====================================================================
//  Portal AAB – Associação dos Advogados do Brasil
//  Projeto Firebase: portaladvocacia
//  Administrador do portal: willbrasilia@gmail.com
//  Cole este conteúdo em Firestore Database → Regras → Publicar
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções auxiliares ----------
    function signed()  { return request.auth != null; }
    function mail()    { return request.auth.token.email.lower(); }
    function isAdmin() { return signed() && request.auth.token.email != null && mail() == 'willbrasilia@gmail.com'; }
    function isMe(uid) { return signed() && request.auth.uid == uid; }

    function assocPath(uid) { return /databases/$(database)/documents/associados/$(uid); }
    function isActive(uid)  { return exists(assocPath(uid)) && get(assocPath(uid)).data.status == 'ativo'; }
    function autoApprove()  {
      return exists(/databases/$(database)/documents/config/portal)
        && get(/databases/$(database)/documents/config/portal).data.get('aprovacaoAuto', false) == true;
    }
    function str(v, max) { return v is string && v.size() <= max; }

    // ---------- configurações do portal ----------
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- comunicados (avisos, alertas, publicações, atualizações) ----------
    match /comunicados/{id} {
      allow read: if isAdmin()
        || (signed() && resource.data.ativo == true)
        || (resource.data.ativo == true && resource.data.publico == true);
      allow write: if isAdmin();
    }

    // ---------- cadastro dos associados ----------
    match /associados/{uid} {
      allow read: if isAdmin() || isMe(uid);

      // o próprio advogado cria o seu cadastro (pendente, ou ativo se a aprovação automática estiver ligada)
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['uid','nome','email','telefone','oab','seccional','status','acessos','criadoAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == mail()
        && str(request.resource.data.nome, 150)
        && str(request.resource.data.telefone, 40)
        && str(request.resource.data.oab, 20)
        && str(request.resource.data.seccional, 2)
        && request.resource.data.acessos == 0
        && (request.resource.data.status == 'pendente'
            || (request.resource.data.status == 'ativo' && autoApprove()));

      // o advogado edita só os próprios dados; nunca o status
      allow update: if isAdmin()
        || (isMe(uid)
            && request.resource.data.status == resource.data.status
            && request.resource.data.email == resource.data.email
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nome','telefone','oab','seccional','ultimoAcesso','visto','acessos','siteSlug'])
            && str(request.resource.data.nome, 150)
            && str(request.resource.data.telefone, 40)
            && str(request.resource.data.oab, 20)
            && str(request.resource.data.seccional, 2)
            // o slug só pode ser definido uma vez e por associado ativo
            && (!('siteSlug' in request.resource.data.diff(resource.data).affectedKeys())
                || (resource.data.get('siteSlug', null) == null && resource.data.status == 'ativo')));

      allow delete: if isAdmin();
    }

    // ---------- sites pessoais ----------
    match /sites/{slug} {
      // público só vê o que está publicado; dono e administrador veem sempre
      allow read: if isAdmin()
        || resource.data.publicado == true
        || (signed() && resource.data.ownerUid == request.auth.uid);

      allow create: if signed()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug == slug
        && slug.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$')
        && request.resource.data.bloqueado == false
        && isActive(request.auth.uid)
        && str(request.resource.data.nome, 150)
        && str(request.resource.data.bio, 3000);

      allow update: if isAdmin()
        || (signed()
            && resource.data.ownerUid == request.auth.uid
            && resource.data.bloqueado == false
            && isActive(request.auth.uid)
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.slug == resource.data.slug
            && request.resource.data.bloqueado == false
            && str(request.resource.data.nome, 150)
            && str(request.resource.data.bio, 3000));

      allow delete: if isAdmin();

      // artigos do advogado (leitura pública só se o artigo e o site estiverem publicados)
      match /artigos/{aid} {
        allow read: if isAdmin()
          || (signed() && get(/databases/$(database)/documents/sites/$(slug)).data.ownerUid == request.auth.uid)
          || (resource.data.publicado == true && get(/databases/$(database)/documents/sites/$(slug)).data.publicado == true);
        allow create, update: if signed()
          && get(/databases/$(database)/documents/sites/$(slug)).data.ownerUid == request.auth.uid
          && isActive(request.auth.uid)
          && str(request.resource.data.titulo, 160)
          && str(request.resource.data.resumo, 400)
          && str(request.resource.data.texto, 15000)
          && request.resource.data.publicado is bool;
        allow delete: if isAdmin()
          || (signed() && get(/databases/$(database)/documents/sites/$(slug)).data.ownerUid == request.auth.uid);
      }

      // inscritos na newsletter de artigos
      match /inscritos/{iid} {
        allow create: if get(/databases/$(database)/documents/sites/$(slug)).data.publicado == true
          && request.resource.data.keys().hasOnly(['nome','email','criadoAt'])
          && str(request.resource.data.nome, 150)
          && str(request.resource.data.email, 150) && request.resource.data.email.size() > 4;
        allow read, delete: if isAdmin()
          || (signed() && get(/databases/$(database)/documents/sites/$(slug)).data.ownerUid == request.auth.uid);
        allow update: if false;
      }

      // mensagens do formulário de contato
      match /mensagens/{mid} {
        allow create: if get(/databases/$(database)/documents/sites/$(slug)).data.publicado == true
          && request.resource.data.keys().hasOnly(['nome','email','telefone','areaInteresse','mensagem','criadoAt','lida'])
          && (!('areaInteresse' in request.resource.data) || str(request.resource.data.areaInteresse, 100))
          && request.resource.data.lida == false
          && str(request.resource.data.nome, 150) && request.resource.data.nome.size() > 0
          && str(request.resource.data.email, 150)
          && str(request.resource.data.telefone, 40)
          && str(request.resource.data.mensagem, 3000) && request.resource.data.mensagem.size() > 0;

        allow read, delete: if isAdmin()
          || (signed() && get(/databases/$(database)/documents/sites/$(slug)).data.ownerUid == request.auth.uid);

        allow update: if isAdmin()
          || (signed() && get(/databases/$(database)/documents/sites/$(slug)).data.ownerUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']));
      }
    }

    // =====================================================================
    //  ÁREA DO CLIENTE (cada advogado só enxerga os próprios dados;
    //  a administração da AAB NÃO tem acesso a clientes, processos, agenda ou tarefas)
    // =====================================================================
    function clientPath(cid) { return /databases/$(database)/documents/clientes/$(cid); }
    function clientOk(uid)   { return exists(clientPath(uid)) && get(clientPath(uid)).data.get('ativo', true) == true; }
    function ownsClient(cid, auid) { return cid == '' || (exists(clientPath(cid)) && get(clientPath(cid)).data.advogadoUid == auid); }
    function lawyerOk() { return signed() && isActive(request.auth.uid); }

    match /clientes/{cid} {
      allow read: if signed() && (resource.data.advogadoUid == request.auth.uid || cid == request.auth.uid);

      // o advogado ativo cria o cliente (a conta de login é criada pelo app)
      allow create: if lawyerOk()
        && request.resource.data.advogadoUid == request.auth.uid
        && request.resource.data.uid == cid
        && cid != request.auth.uid
        && !exists(assocPath(cid))
        && request.resource.data.email.lower() != 'willbrasilia@gmail.com'
        && request.resource.data.keys().hasOnly(['uid','nome','email','telefone','advogadoUid','advogadoNome','siteSlug','ativo','criadoAt'])
        && str(request.resource.data.nome, 150) && str(request.resource.data.email, 150) && str(request.resource.data.telefone, 40)
        && request.resource.data.ativo == true;

      allow update: if lawyerOk()
        && resource.data.advogadoUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','telefone','ativo'])
        && str(request.resource.data.nome, 150) && str(request.resource.data.telefone, 40);

      allow delete: if signed() && resource.data.advogadoUid == request.auth.uid;
    }

    match /processos/{pid} {
      function procPath() { return /databases/$(database)/documents/processos/$(pid); }

      allow read: if signed() && (resource.data.advogadoUid == request.auth.uid
        || (resource.data.clienteUid == request.auth.uid && clientOk(request.auth.uid)));

      allow create: if lawyerOk()
        && request.resource.data.advogadoUid == request.auth.uid
        && ownsClient(request.resource.data.clienteUid, request.auth.uid)
        && str(request.resource.data.titulo, 200) && str(request.resource.data.notas, 3000) && str(request.resource.data.resumoCliente, 1500);

      allow update: if lawyerOk()
        && resource.data.advogadoUid == request.auth.uid
        && request.resource.data.advogadoUid == resource.data.advogadoUid
        && (request.resource.data.clienteUid == resource.data.clienteUid || ownsClient(request.resource.data.clienteUid, request.auth.uid))
        && str(request.resource.data.titulo, 200) && str(request.resource.data.notas, 3000) && str(request.resource.data.resumoCliente, 1500);

      allow delete: if signed() && resource.data.advogadoUid == request.auth.uid;

      match /andamentos/{aid} {
        allow read: if signed() && (get(procPath()).data.advogadoUid == request.auth.uid
          || (resource.data.visivelCliente == true && get(procPath()).data.clienteUid == request.auth.uid && clientOk(request.auth.uid)));
        allow create, update: if lawyerOk()
          && get(procPath()).data.advogadoUid == request.auth.uid
          && str(request.resource.data.texto, 3000) && request.resource.data.visivelCliente is bool;
        allow delete: if signed() && get(procPath()).data.advogadoUid == request.auth.uid;
      }
    }

    match /eventos/{eid} {
      allow read: if signed() && (resource.data.advogadoUid == request.auth.uid
        || (resource.data.clienteUid == request.auth.uid && resource.data.visivelCliente == true && clientOk(request.auth.uid)));
      allow create: if lawyerOk()
        && request.resource.data.advogadoUid == request.auth.uid
        && ownsClient(request.resource.data.clienteUid, request.auth.uid)
        && str(request.resource.data.titulo, 160) && str(request.resource.data.notas, 1000);
      allow update: if lawyerOk()
        && resource.data.advogadoUid == request.auth.uid
        && request.resource.data.advogadoUid == resource.data.advogadoUid
        && (request.resource.data.clienteUid == resource.data.clienteUid || ownsClient(request.resource.data.clienteUid, request.auth.uid))
        && str(request.resource.data.titulo, 160) && str(request.resource.data.notas, 1000);
      allow delete: if signed() && resource.data.advogadoUid == request.auth.uid;
    }

    match /tarefas/{tid} {
      allow read, delete: if signed() && resource.data.advogadoUid == request.auth.uid;
      allow create: if lawyerOk() && request.resource.data.advogadoUid == request.auth.uid
        && str(request.resource.data.titulo, 160) && str(request.resource.data.descricao, 1500);
      allow update: if lawyerOk() && resource.data.advogadoUid == request.auth.uid
        && request.resource.data.advogadoUid == resource.data.advogadoUid
        && str(request.resource.data.titulo, 160) && str(request.resource.data.descricao, 1500);
    }

    // ---------- registro de acessos ----------
    match /logins/{id} {
      allow create: if signed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == mail()
        && request.resource.data.tipo in ['login','admin']
        && (request.resource.data.tipo == 'login' || isAdmin());
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // tudo o mais fica bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
